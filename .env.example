# ─────────────────────────────────────────────────────────────────────────────
# Инфраструктура. Этот файл читает docker compose — и для подстановки в
# compose.yaml (${APP_PORT} и прочее), и как env_file контейнеров.
#
# Конфиг приложения живёт отдельно, в src/.env. Переменные отсюда попадают
# в контейнер как настоящие переменные окружения и ПЕРЕКРЫВАЮТ одноимённые
# из src/.env: Laravel читает .env иммутабельно и не трогает то, что уже
# выставлено в окружении. Поэтому DB_* задаются здесь — чтобы приложение
# и сервис postgres не разъезжались. APP_KEY здесь быть не должно: пустое
# значение перекроет настоящий ключ из src/.env, и приложение упадёт.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Docker: имя проекта, порты, сборка ──────────────────────────────────────
COMPOSE_PROJECT_NAME=fiberglass
PHP_TARGET=dev
APP_PORT=8080
VITE_PORT=5173
DB_PORT_FORWARD=5432

# UID/GID хоста — только для Linux/WSL, чтобы bind-mount не разъезжался
# по правам. На Windows и macOS оставь как есть.
UID=1000
GID=1000

# ─── PHP ─────────────────────────────────────────────────────────────────────
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=512M
PHP_POST_MAX_SIZE=512M
PHP_MAX_EXECUTION_TIME=300
PHP_TIMEZONE=UTC

# off | debug | develop | coverage — включать точечно, xdebug сильно тормозит
# разбор мешей
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Тот же набор используется для инициализации контейнера postgres.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fiberglass
DB_USERNAME=fiberglass
DB_PASSWORD=secret

# ─── Фронтенд ────────────────────────────────────────────────────────────────
CHOKIDAR_USEPOLLING=true
