# Приложение в backend/ закрыто собственными .gitignore Laravel — vendor,
# node_modules, storage, public/build и прочее описаны там. Здесь только то,
# что лежит в корне репозитория.

# ─── Конфигурация окружения ──────────────────────────────────────────────────
# Корневой .env — креды БД и настройки инфраструктуры. В репозиторий едет
# только пример.
/.env
/.env.*
!/.env.example

# Локальные переопределения compose
/compose.override.yaml
/compose.override.yml
/docker-compose.override.yaml
/docker-compose.override.yml

# ─── IDE и редакторы ─────────────────────────────────────────────────────────
/.idea/
/.vscode/
/.fleet/
/.zed/
*.iml

# ─── ОС ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Прочее ──────────────────────────────────────────────────────────────────
*.log

# Проектный документ — не публикуем
/fiberglass-calculator-design.md
/README.docker.md

# Сборочные артефакты нативного компонента (этап 5)
/mesh-analyzer/target/
